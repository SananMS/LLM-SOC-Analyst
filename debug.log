    "content": "Playbook: {\"playbook_name\": \"Suspicious PowerShell Triage\", \"description\": \"LLM-based SOP for triaging PowerShell alerts. Prioritizes identifying administrative tools via script content analysis, process lineage, and historical correlation to classify activity as LP or HP.\", \"steps\": [{\"step_id\": 1, \"task\": \"Extract Execution Metadata\", \"action\": \"Parse the alert JSON for 'user', 'endpoint', and 'scriptblock'. Search for 'parent_process_name' or 'caller_process' evidence if available.\", \"logic\": \"Metadata provides context. If parent lineage is missing, the LLM relies more heavily on script behavior and historical data for classification.\"}, {\"step_id\": 2, \"task\": \"Script Normalization and Content Analysis\", \"action\": \"Examine the 'scriptblock'. If Base64 encoded, invoke 'decode_base64'. Analyze plaintext for 'Admin Tool Signatures' (e.g., specific file paths, vendor-agnostic agent variables, or log directories).\", \"tool_integration\": \"decode_base64\", \"logic\": \"Search for 'Admin Markers' such as references to application installation folders or temporary working directories that indicate an authorized administrative tool.\"}, {\"step_id\": 3, \"task\": \"Correlate with Historical Activity and Past Alerts\", \"action\": \"Invoke 'get_recent_events' and 'get_recent_similar_alerts' to examine the historical frequency of this script logic within the environment.\", \"tool_integration\": [\"get_recent_events\", \"get_recent_similar_alerts\"], \"logic\": \"Compare current activity against historical logs. If identical scripts have run frequently and were previously classified as expected activity, the current alert is highly likely to be LP.\"}, {\"step_id\": 4, \"task\": \"Contextual Correlation\", \"action\": \"Synthesize the (decoded) script logic, identified admin markers, and historical frequency against the user/system context.\", \"logic\": \"Activity is categorized based on the alignment of the script's function (e.g., inventory collection) with its internal markers, even if general process data is absent.\"}, {\"step_id\": 5, \"task\": \"Final Triage Classification\", \"action\": \"Assign a triage priority (LP or HP) by correlating process legitimacy, script markers, user patterns, historical context, and concurrent host activity.\", \"logic\": \"Classification rules (precedence order):\\n\\n1. **Low Priority (LP)** if:\\n   - A process is identified that correlates to known software AND the script logic is a functional requirement for that software.\\n   - OR a similar script activity was previously confirmed as authorized by the client or identified as legitimate in past analyst notes.\\n   - OR recent events on the same host provide a legitimate explanation for the script (e.g., a known software update, agent installation, or similar cases preceding the alert).\\n   - OR the script logic is a benign system task originating from a verified SYSTEM or service account.\\n\\n2. **High Priority (HP)** if:\\n   - A process is identified but the script logic is NOT expected behavior for that software.\\n   - OR the script is run by a non-service account (actual human username) at an unusual time, and the script logic is suspicious (e.g., credential access) with no supporting host activity to explain it.\\n   - OR the script is heavily obfuscated and lacks any identifiable authorized application paths, client confirmations, or matching historical patterns.\\n   - OR the activity originates from a high-risk application (e.g., Office, Browser).\"}, {\"step_id\": 6, \"task\": \"Generate Investigation Summary\", \"action\": \"Construct a concise Description field for the final JSON output.\", \"logic\": \"The Description MUST include: 1) A short summary of what the script actually does (e.g., 'enumerates AD Organizational Units and GPOs'), 2) Key observations from the triage steps, and 3) The reasoning for the LP or HP classification.\"}]}\nAlert: {\"alert_id\": \"SOC-2281\", \"alert_name\": \"Suspicious PowerShell Script Execution\", \"start_time\": \"2026-01-25T14:40:12.000Z\", \"source_ip\": \"10.10.15.22\", \"endpoint\": \"DC-EAST-01\", \"user\": \"SYSTEM\", \"user_id\": \"S-1-5-18\", \"description\": \"A suspicious PowerShell script was executed on the host.\", \"evidence\": {\"scriptblock\": \"[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; $ProgressPreference = 'SilentlyContinue'\\n\\n# Helper function to handle null values and escape special characters\\nfunction HandleString($value) {\\n    if ($null -eq $value) { \\n        return \\\"-\\\" \\n    } else { \\n        return $value -replace '\\\"', '\\\\\\\"'  # Escape double quotes\\n    }\\n}\\n\\ntry {\\n    $details = @()\\n    $domain = HandleString((Get-ADDomainController).Forest)\\n\\n    # Default Domain Password Policy\\n    $passwordPolicy = Get-ADDefaultDomainPasswordPolicy \\n    $details += @{\\n        domain = $domain\\n        name = \\\"Default Domain Policy\\\"\\n        complexityenabled = $passwordPolicy.ComplexityEnabled\\n        distinguishedname = HandleString($passwordPolicy.DistinguishedName)\\n        lockoutduration = [String]$passwordPolicy.lockoutDuration\\n        lockoutobservationwindow = [String]$passwordPolicy.LockoutObservationWindow\\n        lockoutthreshold = [String]$passwordPolicy.LockoutThreshold\\n        objectguid = HandleString([String]$passwordPolicy.ObjectGuid)\\n        maxpwdage = $passwordPolicy.MaxPasswordAge.Days\\n        minpwdage = $passwordPolicy.MinPasswordAge.Days\\n        minpwdlength = $passwordPolicy.MinPasswordLength\\n        pwdhistorylength = $passwordPolicy.PasswordHistoryCount\\n        reversibleencryptionenabled = $passwordPolicy.reversibleEncryptionEnabled\\n    }\\n\\n    # Fine-Grained Password Policies\\n    $ADFineGrainedPasswordPolicy = Get-ADFineGrainedPasswordPolicy -Filter *\\n    if ($ADFineGrainedPasswordPolicy) {\\n        foreach ($o in $ADFineGrainedPasswordPolicy) {\\n            $details += @{\\n                domain = $domain\\n                name = HandleString($o.Name)\\n                complexityenabled = $o.ComplexityEnabled\\n                distinguishedname = HandleString($o.DistinguishedName)\\n                lockoutduration = [String]$o.lockoutDuration\\n                lockoutobservationwindow = [String]$o.LockoutObservationWindow\\n                lockoutthreshold = [String]$o.LockoutThreshold\\n                maxpwdage = $o.MaxPasswordAge.Days\\n                objectguid = HandleString([String]$o.ObjectGuid)\\n                minpwdage = $o.MinPasswordAge.Days\\n                minpwdlength = $o.MinPasswordLength\\n                pwdhistorylength = $o.PasswordHistoryCount\\n                reversibleencryptionenabled = $o.reversibleEncryptionEnabled\\n            }\\n        }\\n    }\\n\\n    # Convert details to JSON with proper depth\\n    ConvertTo-Json -Depth 5 -Compress @{\\n        status = $true\\n        data = $details\\n    }\\n}\\ncatch {\\n    ConvertTo-Json -Depth 5 -Compress @{\\n        status = $false\\n        msg = $( $_.Exception.Message )\\n        stackTrace = $_ | Out-String\\n    }\\n}\", \"os\": \"Windows Server 2022 Datacenter\"}, \"technique\": {\"name\": \"Password Policy Discovery\", \"killchain_stage\": \"Discovery\"}}"
  }
]

