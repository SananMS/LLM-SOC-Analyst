\": \"Azure Network Security Modification\", \"start_time\": \"2026-02-11T09:15:00.000Z\", \"description\": \"A suspicious Azure activity was detected. This detection was triggered by a rule with the following description:\\\"Identifies when a Virtual Network is modified or deleted in Azure.\\\"\", \"evidence\": {\"principalId\": \"e9a8b7c6-d5e4-f3a2-b1c0-d9e8f7a6b5c4\", \"principalType\": \"User\", \"role\": \"Contributor\", \"roleAssignmentId\": \"1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d\", \"roleAssignmentScope\": \"/subscriptions/228e1d3b-9311-4477-8c1d-112233445566\", \"roleDefinitionId\": \"b24988ac-6180-42a0-ab88-20f7382dd24c\", \"scope\": \"/subscriptions/228e1d3b-9311-4477-8c1d-112233445566/resourceGroups/rg-baltic-prod-connectivity/providers/Microsoft.Network/networkSecurityGroups/nsg-tallinn-prod-01\", \"operationName\": \"MICROSOFT.NETWORK/NETWORKSECURITYGROUPS/SECURITYRULES/DELETE\", \"correlationId\": \"f9e8d7c6-b5a4-4321-8877-665544332211\", \"resultSignature\": \"Succeeded\", \"caller_ip\": \"145.14.39.114\", \"caller_ip_geo\": {\"city\": \"Tallinn\", \"countryCode\": \"EE\", \"countryName\": \"Estonia\", \"region\": \"Harjumaa\"}, \"claims\": {\"http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name\": \"markus.tamm@globalcorp.ee\", \"http://schemas.xmlsoap.org/ws/2005/05/identity/claims/upn\": \"markus.tamm@globalcorp.ee\", \"http://schemas.microsoft.com/claims/authnmethodsreferences\": \"pwd,fido,mfa\", \"http://schemas.microsoft.com/identity/claims/tenantid\": \"d1c2b3a4-e5f6-7a8b-9c0d-1e2f3a4b5c6d\", \"ipaddr\": \"145.14.39.114\", \"name\": \"Markus Tamm\"}}}"
  }
