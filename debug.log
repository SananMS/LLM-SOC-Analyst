  {
    "role": "user",
    "content": "Playbook: {\"playbook_name\": \"Suspicious Login Triage\", \"description\": \"SOP for triaging anomalous logins based on ISP Usage Type, device management signals, historical country confirmation status, and regional travel plausibility.\", \"steps\": [{\"step_id\": 1, \"task\": \"Identify Source IP, Device, and Authentication Context\", \"action\": \"Extract the Source IP, Username, MFA status, login timestamp, and device management status (if available) from the alert evidence.\", \"requirement\": \"Verify if the Login Result was 'success' and if MFA was not used (MFA: false).\"}, {\"step_id\": 2, \"task\": \"Perform IP and ISP Usage Analysis\", \"action\": \"Invoke 'check_ip_reputation' to retrieve the Security Score, ISP Name, Usage Type, and VPN status for the Source IP.\", \"tool_integration\": \"check_ip_reputation\", \"logic\": \"Connections identified as 'Data Center/Web Hosting/Proxy' are high-risk. 'Fixed Line ISP' is lower risk unless the Security Score is elevated. VPN usage is evaluated together with device management signals and IP reputation.\"}, {\"step_id\": 3, \"task\": \"Correlate with Historical Activity and Client Confirmations\", \"action\": \"Invoke 'get_recent_events' and 'get_recent_similar_alerts' to examine the user's geographical history and past analyst notes.\", \"tool_integration\": [\"get_recent_events\", \"get_recent_similar_alerts\"], \"logic\": \"Compare the current country against historically confirmed client locations. If the country is new and has no prior client confirmation, further contextual validation is required before classification.\"}, {\"step_id\": 4, \"task\": \"Final Correlation and Triage Decision\", \"action\": \"Evaluate the current country, ISP Usage Type, device management status, IP reputation, login timing, and historical evidence.\", \"logic\": \"Classification rules (precedence order):\\n\\n1. **Low Priority (LP)** if:\\n   - The IP is confirmed as a VPN **AND** the device is confirmed as company-managed **AND** the Security Score \\u00e2\\u2030\\u00a4 50.  \\n     _**This rule now overrides ISP type or novel country location.**_\\n   - OR Usage Type is 'Fixed Line' AND the country has been historically confirmed by the client.\\n   - OR the login originates from a geographically proximate or regionally related country, login time is realistic, Security Score \\u00e2\\u2030\\u00a4 50, and prior client-confirmed activity exists nearby.\\n\\n2. **High Priority (HP)** if none of the LP rules apply, including:\\n   - The login originates from a country with no prior client confirmation AND no regional or temporal plausibility.\\n   - OR Usage Type is 'Data Center/Proxy' or any other type without prior confirmation.\\n   - OR Security Score > 50.\\n   - OR the IP is a VPN BUT the device is **not** company-managed OR the Security Score > 50.\"}]}\nAlert: {\"alert_id\": \"SOC-65\", \"alert_name\": \"User Login Location Anomaly\", \"start_time\": \"2025-07-17T14:22:15.000Z\", \"source_ip\": \"45.78.217.136\", \"destination_ip\": \"13.80.23.7\", \"user\": \"martin.kask@client.ee\", \"user_id\": \"a7f2c9e4-61bd-4f8b-9c32-5d4a18b6f0e9\", \"description\": \"An anomalous Office 365 login occurred from Singapore, Singapore, which is outside the user's typical login region.\", \"evidence\": {\"login_type\": \"o365_login\", \"login_result\": \"success\", \"has_mfa\": false, \"user_agent\": \"Windows-AzureAD-Authentication-Provider/1.0\", \"os\": \"Windows\", \"geo_location\": {\"city\": \"Singapore\", \"country\": \"Singapore\"}}, \"technique\": {\"name\": \"XDR Location Anomaly\", \"killchain_stage\": \"Initial Attempts\"}}"
  }
]

