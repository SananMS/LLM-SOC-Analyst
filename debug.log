 deleted.\\\"\", \"evidence\": {\"principalId\": \"m1r2o3d4-z5u6-4a7b-8c9d-0e1f2a3b4c5d\", \"principalType\": \"User\", \"role\": \"Contributor\", \"roleAssignmentId\": \"9c8d7e6f-5a4b-3c2d-1e0f-9a8b7c6d5e4f\", \"roleAssignmentScope\": \"/subscriptions/228e1d3b-9311-4477-8c1d-112233445566\", \"roleDefinitionId\": \"b24988ac-6180-42a0-ab88-20f7382dd24c\", \"scope\": \"/subscriptions/228e1d3b-9311-4477-8c1d-112233445566/resourceGroups/rg-baltic-prod-connectivity/providers/Microsoft.Network/networkSecurityGroups/nsg-prod-edge-01\", \"operationName\": \"MICROSOFT.NETWORK/NETWORKSECURITYGROUPS/DELETE\", \"correlationId\": \"a1b2c3d4-e5f6-7a8b-9c0d-e1f2a3b4c5d6\", \"resultSignature\": \"Succeeded\", \"caller_ip\": \"186.155.12.88\", \"caller_ip_geo\": {\"city\": \"Bogot\\u00e1\", \"countryCode\": \"CO\", \"countryName\": \"Colombia\", \"region\": \"Bogot\\u00e1 D.C.\"}, \"claims\": {\"http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name\": \"mateo.rodriguez@globalcorp.ee\", \"http://schemas.xmlsoap.org/ws/2005/05/identity/claims/upn\": \"mateo.rodriguez@globalcorp.ee\", \"http://schemas.microsoft.com/claims/authnmethodsreferences\": \"fido,mfa\", \"http://schemas.microsoft.com/identity/claims/tenantid\": \"d1c2b3a4-e5f6-7a8b-9c0d-1e2f3a4b5c6d\", \"ipaddr\": \"186.155.12.88\", \"name\": \"Mateo Rodriguez\"}}}"
