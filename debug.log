_files\": [\"Gehaltsabrechnung_Februar_Export.csv\", \"Jahresabschluss_2025_Entwurf.pdf\", \"Kreditorenrechnung_DE_9941.pdf\", \"Mitarbeiterliste_Abrechnung.xlsx\", \"Umsatzsteuer_Voranmeldung_Q1.pdf\", \"Kontoauszug_DeutscheBank_M\\u00e4rz.csv\", \"Offene_Posten_Liste_Januar.xlsx\", \"Verbindlichkeiten_\\u00dcbersicht_GmbH.csv\", \"Anlagenverzeichnis_Inventur_2026.xlsx\", \"Cashflow_Bericht_Unternehmensf\\u00fchrung.pdf\"], \"sample_paths\": [\"Finanzwesen/Personalabrechnung/Exporte/\", \"Finanzwesen/Berichterstattung/Archiv/\", \"Finanzwesen/Reingang/Eingangsrechnungen/\", \"Finanzwesen/Geh\\u00e4lter/Monatslisten/\", \"Finanzwesen/Steuern/Meldungen/\", \"Finanzwesen/Banking/Ausz\\u00fcge/\", \"Finanzwesen/Buchhaltung/Forderungen/\", \"Finanzwesen/Buchhaltung/Verbindlichkeiten/\", \"Finanzwesen/Inventar/Anlagen/\", \"Finanzwesen/Controlling/Berichte/\"]}}"
  }
]

