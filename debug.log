\": \"Azure Network Security Modification\", \"start_time\": \"2026-02-10T09:15:00.000Z\", \"description\": \"A suspicious Azure activity was detected. This detection was triggered by a rule with the following description:\\\"Identifies when a network security configuration is modified or deleted.\\\"\", \"evidence\": {\"principalId\": \"m1w2b3b4-c5d6-4a7b-8c9d-0e1f2a3b4c5d\", \"principalType\": \"User\", \"role\": \"Contributor\", \"roleAssignmentId\": \"7a6b5c4d-3e2f-1a0b-9c8d-7e6f5a4b3c2d\", \"roleAssignmentScope\": \"/subscriptions/228e1d3b-9311-4477-8c1d-112233445566\", \"roleDefinitionId\": \"8e3af657a8ff443ca75c2fe8c4bcb635\", \"scope\": \"/subscriptions/228e1d3b-9311-4477-8c1d-112233445566/resourceGroups/rg-baltic-prod-connectivity/providers/Microsoft.Network/networkSecurityGroups/nsg-prod-core\", \"operationName\": \"MICROSOFT.NETWORK/NETWORKSECURITYGROUPS/WRITE\", \"correlationId\": \"e1f2a3b4-c5d6-7e8f-9g0h-1i2j3k4l5m6n\", \"resultSignature\": \"Succeeded\", \"caller_ip\": \"194.126.101.99\", \"caller_ip_geo\": {\"city\": \"Tallinn\", \"countryCode\": \"EE\", \"countryName\": \"Estonia\", \"region\": \"Harju County\"}, \"claims\": {\"http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name\": \"marcus.webb@globalcorp.ee\", \"http://schemas.xmlsoap.org/ws/2005/05/identity/claims/upn\": \"marcus.webb@globalcorp.ee\", \"http://schemas.microsoft.com/claims/authnmethodsreferences\": \"pwd,mfa\", \"http://schemas.microsoft.com/identity/claims/tenantid\": \"d1c2b3a4-e5f6-7a8b-9c0d-1e2f3a4b5c6d\", \"ipaddr\": \"194.126.101.99\", \"name\": \"Marcus Webb\"}, \"request_body\": \"{\\\"properties\\\":{\\\"securityRules\\\":[{\\\"name\\\":\\\"Test\\\",\\\"properties\\\":{\\\"access\\\":\\\"Allow\\\",\\\"description\\\":\\\"Temporary access for review\\\",\\\"destinationAddressPrefix\\\":\\\"*\\\",\\\"destinationPortRange\\\":\\\"3389\\\",\\\"direction\\\":\\\"Inbound\\\",\\\"priority\\\":110,\\\"protocol\\\":\\\"Tcp\\\",\\\"sourceAddressPrefix\\\":\\\"*\\\"}}]}}\"}}"
  }
]

