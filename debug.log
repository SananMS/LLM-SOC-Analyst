    "content": "Playbook: {\"playbook_name\": \"Suspicious PowerShell Triage\", \"description\": \"LLM-based SOP for triaging PowerShell alerts. Prioritizes identifying administrative tools via internal script decoding, file path validation (if available), dual-layer process lineage, and VirusTotal reputation.\", \"steps\": [{\"step_id\": 1, \"task\": \"Extract Execution Metadata & Lineage\", \"action\": \"Parse alert JSON for 'user', 'endpoint', 'scriptblock', 'file_path', 'initiating_process', 'parent_process', and 'process_sha256'.\", \"logic\": \"Metadata provides initial context. Note if 'file_path' is present; its absence may indicate a direct-to-memory execution (higher risk) or a logging limitation.\"}, {\"step_id\": 2, \"task\": \"External Reputation Check\", \"action\": \"Invoke 'check_virustotal' using the 'process_sha256' of the initiating process.\", \"tool_integration\": \"check_virustotal\", \"logic\": \"Determines if the binary responsible for spawning PowerShell is known-malicious. If detections >= 5, immediately flag for HP.\"}, {\"step_id\": 3, \"task\": \"Script Normalization and Content Analysis\", \"action\": \"Internally decode 'scriptblock' if Base64 encoded. Analyze for 'Admin Tool Signatures' (e.g., installer paths, authenticode checks) and cross-reference with the 'file_path' ONLY if it exists.\", \"logic\": \"Matches script intent (e.g., updater logic) with its physical location if known. If the script references a specific path that is NOT present in 'file_path', highlight the discrepancy.\"}, {\"step_id\": 4, \"task\": \"Correlate with Historical Activity\", \"action\": \"MAKE SURE TO INVOKE 'get_recent_events' and 'get_recent_similar_alerts' to understand context of the alert.\", \"tool_integration\": [\"get_recent_events\", \"get_recent_similar_alerts\"], \"logic\": \"Consistency in script logic and pathing across the environment typically suggests standard operational behavior (LP).\"}, {\"step_id\": 5, \"task\": \"External Network Context Validation (IP Address)\", \"action\": \"Extract external IP addresses from the decoded 'scriptblock', 'get_recent_events', and 'get_recent_similar_alerts' results, then invoke 'check_ip_reputation' (AbuseIPDB) for each identified IP. This is only if they exist in the script or correlated data. If not, skip this step.\", \"tool_integration\": \"check_ip_reputation\", \"logic\": \"IP reputation is used as contextual enrichment only. Regardless of AbuseIPDB score, the presence of hard-coded external IP communication within scripts exhibiting reverse shell, command-and-control, or interactive execution behavior should be treated as malicious by behavior. Reputation data is used to strengthen confidence, identify infrastructure reuse, and support campaign correlation\\u00e2\\u20ac\\u201dnot to downgrade severity.\"}, {\"step_id\": 6, \"task\": \"Final Triage Classification\", \"action\": \"Assign triage priority (LP or HP) by considering available context: process legitimacy, script behavior, execution environment, historical alerts, and network indicators if present.\", \"logic\": \"Classification rules:\\n\\n1. **Low Priority (LP)** if:\\n   - The user account executing the script is a known service or administrative account AND the script performs standard operational or maintenance tasks consistent with expected internal policies. \\n   - OR the script performs standard operational or maintenance tasks consistent with expected internal policies.\\n   - OR historical alerts show the same or similar scripts have executed previously without incident.\\n   \\n   > Note: LP does not require VirusTotal data, file paths, or IP reputation if they are unavailable. If those exist, they can optionally reinforce confidence.\\n\\n2. **High Priority (HP)** if:\\n   - The script shows unexpected or anomalous behavior outside normal administrative tasks.\\n   - OR the process is unknown, untrusted, or flagged as malicious (e.g., VirusTotal detections >=5).\\n   - OR command-and-control, reverse shell, or interactive execution behavior is observed.\\n   - OR the alert lacks context for critical operations and cannot be correlated with trusted service accounts or historical benign activity.\"}, {\"step_id\": 7, \"task\": \"Generate Investigation Summary\", \"action\": \"Construct a concise Description field including: 1) Script intent, 2) VT and AbuseIPDB results, if they exist, and 3) Final reasoning.\", \"logic\": \"Ensures the summary explicitly clarifies whether the triage was based on a physical file path or script behavior alone.\"}]}\nAlert: {\"alert_id\": \"SOC-2281\", \"alert_name\": \"Suspicious PowerShell Script Execution\", \"start_time\": \"2026-01-25T14:40:12.000Z\", \"source_ip\": \"10.10.15.22\", \"endpoint\": \"DC-EAST-01\", \"user\": \"SYSTEM\", \"user_id\": \"S-1-5-18\", \"description\": \"A suspicious PowerShell script was executed on the host.\", \"evidence\": {\"scriptblock\": \"[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; $ProgressPreference = 'SilentlyContinue'\\n\\n# Helper function to handle null values and escape special characters\\nfunction HandleString($value) {\\n    if ($null -eq $value) { \\n        return \\\"-\\\" \\n    } else { \\n        return $value -replace '\\\"', '\\\\\\\"'  # Escape double quotes\\n    }\\n}\\n\\ntry {\\n    $details = @()\\n    $domain = HandleString((Get-ADDomainController).Forest)\\n\\n    # Default Domain Password Policy\\n    $passwordPolicy = Get-ADDefaultDomainPasswordPolicy \\n    $details += @{\\n        domain = $domain\\n        name = \\\"Default Domain Policy\\\"\\n        complexityenabled = $passwordPolicy.ComplexityEnabled\\n        distinguishedname = HandleString($passwordPolicy.DistinguishedName)\\n        lockoutduration = [String]$passwordPolicy.lockoutDuration\\n        lockoutobservationwindow = [String]$passwordPolicy.LockoutObservationWindow\\n        lockoutthreshold = [String]$passwordPolicy.LockoutThreshold\\n        objectguid = HandleString([String]$passwordPolicy.ObjectGuid)\\n        maxpwdage = $passwordPolicy.MaxPasswordAge.Days\\n        minpwdage = $passwordPolicy.MinPasswordAge.Days\\n        minpwdlength = $passwordPolicy.MinPasswordLength\\n        pwdhistorylength = $passwordPolicy.PasswordHistoryCount\\n        reversibleencryptionenabled = $passwordPolicy.reversibleEncryptionEnabled\\n    }\\n\\n    # Fine-Grained Password Policies\\n    $ADFineGrainedPasswordPolicy = Get-ADFineGrainedPasswordPolicy -Filter *\\n    if ($ADFineGrainedPasswordPolicy) {\\n        foreach ($o in $ADFineGrainedPasswordPolicy) {\\n            $details += @{\\n                domain = $domain\\n                name = HandleString($o.Name)\\n                complexityenabled = $o.ComplexityEnabled\\n                distinguishedname = HandleString($o.DistinguishedName)\\n                lockoutduration = [String]$o.lockoutDuration\\n                lockoutobservationwindow = [String]$o.LockoutObservationWindow\\n                lockoutthreshold = [String]$o.LockoutThreshold\\n                maxpwdage = $o.MaxPasswordAge.Days\\n                objectguid = HandleString([String]$o.ObjectGuid)\\n                minpwdage = $o.MinPasswordAge.Days\\n                minpwdlength = $o.MinPasswordLength\\n                pwdhistorylength = $o.PasswordHistoryCount\\n                reversibleencryptionenabled = $o.reversibleEncryptionEnabled\\n            }\\n        }\\n    }\\n\\n    # Convert details to JSON with proper depth\\n    ConvertTo-Json -Depth 5 -Compress @{\\n        status = $true\\n        data = $details\\n    }\\n}\\ncatch {\\n    ConvertTo-Json -Depth 5 -Compress @{\\n        status = $false\\n        msg = $( $_.Exception.Message )\\n        stackTrace = $_ | Out-String\\n    }\\n}\", \"os\": \"Windows Server 2022 Datacenter\"}, \"technique\": {\"name\": \"Password Policy Discovery\", \"killchain_stage\": \"Discovery\"}}"
  }
]

